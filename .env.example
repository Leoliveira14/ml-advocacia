# Copie este arquivo para .env e preencha. NUNCA publique o .env.

# Servidor
PORT=3000
NODE_ENV=production
# Endereço público do site, sem barra no final (usado em canonical, Open Graph e sitemap)
SITE_URL=https://www.seudominio.com.br
# Use 1 se o site estiver atrás de um proxy/CDN (Render, Railway, Nginx, Cloudflare)
TRUST_PROXY=1
# Pasta do banco de dados SQLite (precisa ser um disco persistente)
DATA_DIR=./data

# Segurança
# Texto aleatório longo, usado para anonimizar IPs (ex.: openssl rand -hex 32)
IP_SALT=
# Painel /admin (usuário e senha com 12+ caracteres)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Integração com CRM / automação (opcional): n8n, Make, Zapier, RD Station via webhook...
CRM_WEBHOOK_URL=
# Segredo para assinar o envio (cabeçalho X-ML-Assinatura: sha256=HMAC do corpo)
CRM_WEBHOOK_SECRET=

# Aviso por e-mail a cada novo contato (opcional, via https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=contato@seudominio.com.br
NOTIFY_EMAIL_FROM=Site M&L <site@seudominio.com.br>

# Assinatura eletrônica pelo Autentique (opcional) — https://www.autentique.com.br
# Chave da API: painel do Autentique → Perfil → Chaves de API. Fica SÓ aqui no servidor.
AUTENTIQUE_TOKEN=
# 1 = modo de teste (sandbox: não gasta créditos e NÃO tem validade jurídica). Mude para 0 para usar de verdade.
AUTENTIQUE_SANDBOX=1
# Segredo do webhook (painel do Autentique → Webhooks). Endereço a cadastrar lá:
#   https://www.seudominio.com.br/api/autentique/webhook  (eventos: signature.viewed, signature.accepted,
#   signature.rejected, signature.delivery_failed, document.finished, document.deleted)
AUTENTIQUE_WEBHOOK_SECRET=
# Dados usados nos modelos de documento (pasta modelos/)
MODELO_ADVOGADO_NOME=
MODELO_ADVOGADO_OAB=OAB/SP 
MODELO_ESCRITORIO_ENDERECO=Av. João XXIII, 183, Sala 1, Vila Formosa, São Paulo - SP
